{
  "name": "@tucatalogo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Hono (sin ruta pública; solo service binding)",
  "exports": {
    ".": "./src/index.ts",
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 9797 --local",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tucatalogo/db": "workspace:*",
    "@tucatalogo/shared": "workspace:*",
    "@tucatalogo/themes": "workspace:*",
    "@tucatalogo/types": "workspace:*",
    "better-auth": "1.7.25",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@cloudflare/workers-types": "5.20261117.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.163.0"
  }
}
