# Copia este archivo a `.dev.vars` (gitignored). Valores SOLO locales.
# `.dev.vars` no se versiona; los secretos reales viven en Worker secrets.
ENVIRONMENT=local
APP_DOMAIN=localhost
API_INTERNAL_URL=http://127.0.0.1:9797
MEDIA_BASE_URL=http://127.0.0.1:9797/media

# Driver de email explícito: memory | console | resend.
# - `memory`: outbox en memoria del isolate + `GET /dev/outbox` (solo local).
#   Es el modo recomendado para navegador/E2E: no ensucia el log.
# - `console`: imprime el OTP/enlace en el log de `wrangler dev`.
# - `resend`: envío real; exige RESEND_API_KEY y remitente.
# `memory` y `console` no se aceptan fuera de local; sin driver → 503.
EMAIL_DRIVER=memory
# Remitente de los correos. Obligatorio cuando EMAIL_DRIVER=resend.
EMAIL_FROM=TuCatálogo <no-reply@localhost>

# Turnstile: test | enabled | disabled (disabled solo en local).
TURNSTILE_MODE=test
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Origen del storefront (con `{slug}`) y del console para los enlaces de reset.
STORE_ORIGIN_TEMPLATE=http://{slug}.localhost:5173
CONSOLE_ORIGIN=http://localhost:5175

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET_STORE=
BETTER_AUTH_SECRET_CONSOLE=
# 32 bytes (64 hex). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INIT_TOKEN=

# Solo si EMAIL_DRIVER=resend (sin clave → 503, no hay fallback).
# RESEND_API_KEY=
# Remitente alternativo; RESEND_FROM tiene prioridad sobre EMAIL_FROM.
# RESEND_FROM=
