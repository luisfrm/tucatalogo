{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tucatalogo-commercial",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "local",
    "APP_DOMAIN": "localhost",
    "API_INTERNAL_URL": "http://127.0.0.1:9797",
    "MEDIA_BASE_URL": "http://127.0.0.1:9797/media",
    "TURNSTILE_MODE": "test",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "env": {
    "dev": {
      "name": "tucatalogo-commercial-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "development",
        "APP_DOMAIN": "REPLACE_ME_DEV_STOREFRONT_HOST",
        "MEDIA_BASE_URL": "REPLACE_ME_DEV_MEDIA_BASE_URL",
        // B9: en dev el widget es real ("enabled"); "test" es exclusivo de local.
        // Requiere la site key de dev y, en el api, el Worker secret
        // TURNSTILE_SECRET_KEY. Si falta cualquiera: 503 visible + log.
        "TURNSTILE_MODE": "enabled",
        "TURNSTILE_SITE_KEY": "REPLACE_ME_DEV_TURNSTILE_SITE_KEY"
      },
      "services": [
        {
          "binding": "API",
          "service": "tucatalogo-api-dev"
        }
      ]
    },
    "prod": {
      "name": "tucatalogo-commercial-prod",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_DOMAIN": "tucatalogo.live",
        "MEDIA_BASE_URL": "https://bucket.tucatalogo.live",
        // B9: Turnstile real en prod. La site key es pública y vive aquí (no es
        // secreta y no va en GitHub); el TURNSTILE_SECRET_KEY es un Worker
        // secret del api, sincronizado desde un GitHub Repository secret. Sin
        // ambos, el registro da 503.
        "TURNSTILE_MODE": "enabled",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGF7HGDrrRDDGsww"
      },
      "services": [
        {
          "binding": "API",
          "service": "tucatalogo-api-prod"
        }
      ],
      "routes": [
        {
          "pattern": "tucatalogo.live/*",
          "zone_name": "tucatalogo.live"
        }
      ]
    }
  }
}
