/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Activos de marca: los nombres no llevan hash y cambiarán cuando se rehaga el
# logo, así que no son `immutable`. Un día de caché evita revalidar en cada
# visita sin dejar el favicon viejo pegado durante semanas.
/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
