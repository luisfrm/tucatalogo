{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tucatalogo-console",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "ENVIRONMENT": "local",
    "APP_DOMAIN": "localhost",
    "API_INTERNAL_URL": "http://127.0.0.1:9797",
    "MEDIA_BASE_URL": "http://127.0.0.1:9797/media"
  },
  "env": {
    "dev": {
      "name": "tucatalogo-console-dev",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "development",
        "APP_DOMAIN": "REPLACE_ME_DEV_CONSOLE_HOST",
        "MEDIA_BASE_URL": "REPLACE_ME_DEV_MEDIA_BASE_URL"
      },
      "services": [
        {
          "binding": "API",
          "service": "tucatalogo-api-dev"
        }
      ]
    },
    "prod": {
      "name": "tucatalogo-console-prod",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_DOMAIN": "luisrivas.site",
        "MEDIA_BASE_URL": "https://tucatalogo-bucket.luisrivas.site"
      },
      "services": [
        {
          "binding": "API",
          "service": "tucatalogo-api-prod"
        }
      ],
      "routes": [
        {
          "pattern": "console-tucatalogo.luisrivas.site/*",
          "zone_name": "luisrivas.site"
        }
      ]
    }
  }
}
